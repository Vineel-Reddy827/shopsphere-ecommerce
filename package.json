{
  "name": "shopsphere",
  "private": true,
  "version": "1.0.0",
  "description": "ShopSphere — Modern e-commerce product catalog. Maincrafts Full Stack Internship Project 6.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run api\" \"vite\"",
    "api": "json-server --watch db.json --port 3001 --routes routes.json",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.44.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.0.0",
    "json-server": "^0.17.4",
    "prettier": "^3.2.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
